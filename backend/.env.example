# Copy to .env — never commit real keys.
# Values starting with "your-" are treated as unset by src/rag/llm.py.
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Optional: Local / OpenAI-compatible LLM (e.g., Ollama, LM Studio, vLLM)
# LLM_PROVIDER=openai_compatible
# LLM_MODEL_NAME=llama3.1
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama-local               # any dummy token with >= 8 chars

# Optional: Compute & Model Overrides
# EMBEDDING_DEVICE=auto                  # auto | cuda | cpu
# INGESTION_DEVICE=auto                  # auto | cuda | cpu
# FLASHRANK_ALLOW_DOWNLOAD=true          # allow downloading FlashRank multilingual reranker
# LAYA_MODEL_NAME=convaiinnovations/laya-multilingual
# INGESTION_HIGH_CONFIDENCE_THRESHOLD=0.85

# Optional: Network & CORS Overrides (comma-separated origins for LAN IP / reverse proxy)
# CORS_ORIGINS=http://192.168.1.50:5173,http://localhost:5173

# Optional: Storage & Service Path Overrides (for non-Docker local runs)
# QDRANT_URL=http://localhost:6333
# DATA_DIR=../data
# DB_DIR=../data/db
# HF_HOME=../data/models/huggingface
# FRONTEND_DIST_DIR=../frontend/dist
